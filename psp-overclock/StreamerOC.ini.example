# Separate kernel plugin; never activated by PSP Streamer itself.
# Keep every other clock plugin and ARK clock override disabled.
enabled=0
# Only a frequency you have tested on THIS PSP. 66..471 MHz.
target_mhz=333
# Reapply if an app changes clocks; stops after 3 conflicts per minute.
enforce=0
# With enforce=1, bypass the 3-per-minute limit AND the app-control exemption.
# Suspend and hardware-error safety shutdowns still apply.
enforce_unlimited=0
# Permit explicit session-only requests from cooperating homebrew (optional).
app_control=1
# Register-derived CPU/PLL/bus estimates in StreamerOC-status.txt.
report=1
# Optional OSD: clock changes automatically show 5 seconds.
# L+R+Triangle shows/hides it manually too.
# 0=off, 1=VBlank polling (default, no hooks), 2=framebuffer syscall hook.
# Mode 2 is experimental; direct/kernel rendering may bypass it.
overlay=1
