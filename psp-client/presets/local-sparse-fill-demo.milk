[preset00]
// PSPStreamer original: 300000 uniform local values, sparse overrides.
fDecay=.93
nWaveMode=0
fWaveAlpha=0
per_frame_init_1=n=0;loop(300000,megabuf(n)=.5;n+=1;);
per_frame_1=megabuf(299999)=.5+.27*sin(time);megabuf(900000)=.5+.23*cos(time*.8);
per_frame_2=gmegabuf(50000)=megabuf(299999);gmegabuf(50001)=megabuf(900000);
per_frame_3=gmegabuf(50002)=megabuf(299998);
shapecode_0_enabled=1
shapecode_0_sides=32
shapecode_0_rad=.065
shapecode_0_r=.1
shapecode_0_g=.85
shapecode_0_b=1
shapecode_0_a=1
shape_0_per_frame1=x=gmegabuf(50000);y=gmegabuf(50001);
shapecode_1_enabled=1
shapecode_1_sides=4
shapecode_1_rad=.035
shapecode_1_r=1
shapecode_1_g=.6
shapecode_1_b=.1
shapecode_1_a=1
shape_1_per_frame1=x=gmegabuf(50002);y=.5;
