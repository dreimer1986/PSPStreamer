// Original PSPStreamer fixture: the cyan wave keeps moving during the fade.
[preset00]
fRating=4
nWaveMode=0
fWaveAlpha=0
fDecay=.92
zoom=1.003
per_frame_1=rot=-.008;warp=.15+.05*bass;
per_pixel_1=dy=.003*cos(time+ang*2);
wavecode_0_enabled=1
wavecode_0_samples=192
wavecode_0_bDrawThick=1
wavecode_0_r=.1
wavecode_0_g=.9
wavecode_0_b=1
wavecode_0_a=.9
wave_0_per_point1=x=sample;y=.5+.2*sin(sample*12+time*3)+.1*value1;
shapecode_0_enabled=1
shapecode_0_sides=3
shapecode_0_rad=.12
shapecode_0_r=.1
shapecode_0_g=.7
shapecode_0_b=1
shapecode_0_a=.8
shapecode_0_a2=.1
shapecode_0_border_a=0
shape_0_per_frame1=x=.5+.25*cos(time*2);y=.5+.2*sin(time*2);ang=-time;
