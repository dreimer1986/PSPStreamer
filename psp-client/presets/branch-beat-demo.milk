; PSPStreamer conditional-formula demo, original preset.
; Bass controls zoom, dotted/continuous wave and smooth echo intensity.
[preset00]
nWaveMode=0
fDecay=0.97
fGammaAdj=1.2
fWaveAlpha=0.8
bWaveThick=1
fVideoEchoZoom=1.5
per_frame_1=zoom=if(above(bass,1.1),1.04,1.008); rot=if(below(sin(time*0.4),0),-0.02,0.02);
per_frame_2=wave_dots=band(above(psp_low,0.3),above(bass,1.1)); echo_alpha=0.35*sigmoid(bass-1,3);
per_frame_3=wave_r=if(above(bass,1.1),1,0.2); wave_g=0.3+0.6*psp_mid; wave_b=if(bnot(wave_dots),1,0.3);
