; PSP fallback check: moving waveform; desktop shader effects are omitted.
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
zoom=1.01
fDecay=0.97
nWaveMode=0
wave_r=0.2
wave_g=0.8
wave_b=1.0
per_frame_1=rot=0.05*sin(time);wave_r=0.5+0.5*sin(time);
warp_1=`shader_body
warp_2=`{
warp_3=`ret=tex2D(sampler_main,uv).xyz;
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`ret=1-tex2D(sampler_main,uv).xyz;
comp_4=`}
