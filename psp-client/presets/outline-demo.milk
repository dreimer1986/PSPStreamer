; PSPStreamer original: left thin / right thick polygon outlines.
; Both feed the same music-reactive warped trail; no external texture needed.
[preset00]
fDecay=.94
fGammaAdj=1.2
fVideoEchoZoom=1.5
fVideoEchoAlpha=.15
zoom=1.015
rot=.002
warp=.15
nWaveMode=0
fWaveAlpha=.3
wave_r=.2
wave_g=.6
wave_b=1
shapecode_0_enabled=1
shapecode_0_sides=6
shapecode_0_x=.28
shapecode_0_y=.5
shapecode_0_rad=.30
shapecode_0_a=0
shapecode_0_a2=0
shapecode_0_border_r=.2
shapecode_0_border_g=.8
shapecode_0_border_b=1
shapecode_0_border_a=.8
shapecode_0_thickOutline=0
shapecode_1_enabled=1
shapecode_1_sides=6
shapecode_1_x=.72
shapecode_1_y=.5
shapecode_1_rad=.30
shapecode_1_a=0
shapecode_1_a2=0
shapecode_1_border_r=.2
shapecode_1_border_g=.8
shapecode_1_border_b=1
shapecode_1_border_a=.8
shapecode_1_thickOutline=1
per_frame_1=rot=.002+.006*psp_low;
