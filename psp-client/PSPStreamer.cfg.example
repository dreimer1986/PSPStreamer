# Copy as ms0:/PSP/SYSTEM/PSPStreamer.cfg and change the endpoint.
# A DNS/DynDNS name or an IPv4 address is accepted.
server=http://streamer.example.net:8091
port=8091
audio=0
subtitle=-1
quality=2
volume=24
shuffle=0
language=en
# off: LCD menus, TV video. auto: native TV menus when component cable is present.
tv_ui=off
