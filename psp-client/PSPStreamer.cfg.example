# Copy as ms0:/PSP/SYSTEM/PSPStreamer.cfg or use SELECT in the app browser.
# A DNS/DynDNS name or an IPv4 address is accepted.
# Automatic next-video prompt: 0 disables it; 1..30 seconds. X starts, O cancels.
next_episode_seconds=0
# Monkey vibration, 0..100 percent; needs the updated USB bridge and a
# controller supported by StreamMaster's existing rumble firmware.
cave_rumble_music=0
cave_rumble_game=0
server=http://streamer.example.net:8091
port=8091
server_password=
# 0 = HTTP (default), 1 = HTTPS with automatic certificate-change notices.
https=0
# wifi (default) or streammaster; save and restart the PSP app after changing.
# StreamMaster requires Onju firmware 0.2.0+ and the matching StreamMasterUSB.prx.
# USB HTTPS uses Onju's trusted root bundle, not the PSP certificate cache.
network_transport=wifi
# 0 disables diagnostic logs/monitoring (default); 1 enables troubleshooting.
debug=0
# Optional StreamerOC profiles: 0 = plugin default; 66-471 MHz, 1 MHz steps.
# Plugin needs enabled=1 and app_control=1; above 333 requires INI target >= request.
music_cpu_mhz=0
milkdrop_cpu_mhz=0
video_cpu_mhz=0
idle_cpu_mhz=0
# LCD: 0 keep awake, 1 allow display idle during music, 2 always allow.
# Uses the PSP's display-off timer; system suspend stays blocked, TV stays on.
screen_idle=0
audio=0
subtitle=-1
quality=2
video_fps=20
play_mode=stream
music_preset=active.milk
preset_auto=0
preset_seconds=60
preset_fade_ms=1500
# 1 = sharper 512x512; 0 = faster original 512x256. No app restart needed.
milkdrop_high_resolution=1
# Music analysis: 0 = original light 12-band path; 1 = desktop MilkDrop FFT.
spectrum_analysis=0
# Analyzer bars in FFT mode: 12, 24, 32, 48 or 64. Light mode always uses 12.
spectrum_bands_lcd=32
spectrum_bands_tv=32
# FFT display gain only (-24..24 dB); does not change volume or effect response.
spectrum_gain_db=0
# Spectrum colors: 0 Original, 1 Rainbow, 2 Classic VU, 3 Ice, 4 Fire.
# Display options apply to Light mode too, LCD/TV and fullscreen.
spectrum_style=1
spectrum_segments=0
# Whole vertical LEDs per bar, 8..32 (independent of frequency-band count).
spectrum_led_count=20
spectrum_peak_hold=1
volume=24
shuffle=0
language=en
# off: LCD menus, TV video. auto: native TV menus when component cable is present.
tv_ui=off
# StreamMaster USB: validated 8 KiB/four-request profile. Zero uses defaults.
# Older firmware/drivers automatically retain their legacy transfer path.
streammaster_bulk_kib=8
streammaster_bulk_depth=4
