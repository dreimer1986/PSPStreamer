# Copy as ms0:/PSP/SYSTEM/PSPStreamer.cfg or use SELECT in the app browser.
# A DNS/DynDNS name or an IPv4 address is accepted.
server=http://streamer.example.net:8091
port=8091
server_password=
# 0 = HTTP (default), 1 = HTTPS with automatic certificate-change notices.
https=0
# 0 disables diagnostic logs/monitoring (default); 1 enables troubleshooting.
debug=0
# Optional StreamerOC profiles: 0 = plugin default; 66-471 MHz, 1 MHz steps.
# Plugin needs enabled=1 and app_control=1; above 333 requires INI target >= request.
music_cpu_mhz=0
milkdrop_cpu_mhz=0
video_cpu_mhz=0
idle_cpu_mhz=0
# LCD: 0 keep awake, 1 allow display idle during music, 2 always allow.
# Uses the PSP's display-off timer; system suspend stays blocked, TV stays on.
screen_idle=0
audio=0
subtitle=-1
quality=2
video_fps=20
play_mode=stream
music_preset=active.milk
preset_auto=0
preset_seconds=60
preset_fade_ms=1500
volume=24
shuffle=0
language=en
# off: LCD menus, TV video. auto: native TV menus when component cable is present.
tv_ui=off
