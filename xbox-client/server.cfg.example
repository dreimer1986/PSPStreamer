# Native player preview: trusted LAN, IPv4, HTTP only. Server >= 0.1.70.
# Copy to server.cfg alongside default.xbe. No scheme or path in host.
host=192.168.181.216
port=8091
password=
# Output height: 480 (default), 576, 720, 1080. Only modes enabled in the Xbox
# video settings and supported by the attached cable are used. Decoded video
# resolution is selected independently in the app. Start with 480.
output_height=480
