struct Input { float4 position: POSITION; float4 color: DIFFUSE; float4 uv: TEXCOORD0; };
struct Output { float4 position: POSITION; float4 color: COLOR; float4 uv: TEXCOORD0; };
Output main(Input input) {
    Output output;
    output.position=input.position;output.color=input.color;output.uv=input.uv;
    return output;
}
