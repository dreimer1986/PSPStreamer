# External USB Bluetooth controller; the internal BLE-only radio stays off.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_A2DP_ENABLE=n
CONFIG_BT_SPP_ENABLED=n
CONFIG_BT_HFP_ENABLE=n
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLUEDROID_ESP_COEX_VSC=n
CONFIG_BT_ENC_KEY_SIZE_CTRL_NONE=y
CONFIG_BT_BTC_TASK_STACK_SIZE=5120
CONFIG_BT_SMP_MAX_BONDS=4
# One external hub only: hub control (1), PSP (3), HCI adapter (4) = 8.
CONFIG_USB_HOST_HUB_MULTI_LEVEL=n
